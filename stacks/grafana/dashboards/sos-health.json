     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "sos-pg"
     },
     "rawSql": "SELECT to_char(finished,'MM-DD HH24:MI') AS finished, source, status, rows, new_rows, left(message,60) AS message FROM fetch_log ORDER BY id DESC LIMIT 14",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
