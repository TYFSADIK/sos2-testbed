  {
   "type": "barchart",
   "title": "Data freshness: median element-set age by regime (days)",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "sos-pg"
     },
     "rawSql": "SELECT regime, round((percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM now()-epoch)/86400))::numeric,2) AS median_age_days, round((percentile_cont(0.9) WITHIN GROUP (ORDER BY extract(epoch FROM now()-epoch)/86400))::numeric,2) AS p90_age_days FROM latest_gp GROUP BY 1 ORDER BY 1",
     "format": "table",
