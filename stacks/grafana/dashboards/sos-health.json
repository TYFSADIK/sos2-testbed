  {
   "type": "table",
   "title": "Highest collision probability (latest screening run)",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "sos-pg"
     },
     "rawSql": "SELECT sa.name AS object_a, sb.name AS object_b, to_char(c.tca,'MM-DD HH24:MI') AS tca_utc, round((c.miss_km*1000)::numeric) AS miss_m,\n round(c.rel_speed_kms::numeric,2) AS rel_kms, c.pc AS probability FROM conjunction c LEFT JOIN satcat sa ON sa.norad=c.a LEFT JOIN satcat sb ON sb.norad=c.b\n WHERE c.run_id=(SELECT max(id) FROM conjunction_run) AND NOT c.colocated ORDER BY c.pc DESC NULLS LAST LIMIT 12",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 10
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "sos-pg"
   }
  },
  {
   "type": "table",
   "title": "Canadian GEO satellites",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "sos-pg"
     },
     "rawSql": "SELECT name, round(lon::numeric,2) AS lon, round(drift_deg_day::numeric,3) AS drift_deg_day, round(inc::numeric,2) AS inc, state FROM geo_state WHERE snapshot=(SELECT max(snapshot) FROM geo_state) AND owner='CA' ORDER BY lon",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 10
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "sos-pg"
   }
  },
  {
   "type": "geomap",
   "title": "Where the 5,000 highest-probability close approaches happen",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "sos-pg"
     },
     "rawSql": "SELECT ST_Y(geom::geometry) AS latitude, ST_X(geom::geometry) AS longitude, miss_km FROM conjunction WHERE run_id=(SELECT max(id) FROM conjunction_run) AND NOT colocated ORDER BY pc DESC NULLS LAST LIMIT 5000",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
