   }
  },
  {
   "type": "table",
   "title": "Manoeuvres detected from element-set history",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "sos-pg"
     },
     "rawSql": "SELECT m.norad, l.name, m.regime, to_char(m.epoch_after,'MM-DD HH24:MI') AS after, round(m.d_sma_km::numeric,2) AS d_sma_km, round(m.d_inc_deg::numeric,4) AS d_inc_deg FROM manoeuvre m LEFT JOIN latest_gp l USING (norad) ORDER BY m.epoch_after DESC LIMIT 15",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
